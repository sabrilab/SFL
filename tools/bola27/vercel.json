{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "node construire.mjs --sortie sortie",
  "outputDirectory": "sortie",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ../../src/app/jouer ../../src/lib/jeu ../../src/lib/utils.ts ../../src/app/globals.css ../../src/app/tokens.css ../../src/app/boutons.css ../../src/app/scelle.css ../../src/app/favicon.ico ../../public/jeu ../../postcss-repli-opacite.cjs ../../package-lock.json ../../tsconfig.json .",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/bola27/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
